                                if (root.chat-muted) {
                                    root.prev-chat-volume = root.chat-volume;
                                    root.chat-volume = 0.0;
                                } else {
                                    root.chat-volume = root.prev-chat-volume > 0.05 ? root.prev-chat-volume : 1.0;
                                }
                                root.chat-volume-changed(root.chat-volume);
                            }
                        }
                    }
                }
            }

            // --- CARD 4: MIC VOLUME ---
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.surface1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // Header
                    Text {
                        text: "Mic Volume";
                        color: Palette.accent-mic;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }

                    // VU Meter & Fader
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 3px;
                            VuMeter { level: root.vu-mic; height: 160px; }
                            VuMeter { level: root.vu-mic; height: 160px; }
                        }

                        // Tactile Fader
                        Rectangle {
                            width: 28px;
                            height: 160px;
                            background: Palette.surface0;
