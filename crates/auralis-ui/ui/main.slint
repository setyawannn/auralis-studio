                    // "To Be Routed" Container (Game: Click to switch to Chat)
                    Text {
                        text: "To Be Routed (Game Apps)";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 72px;
                        background: Palette.surface0;
                        border-radius: 6px;
