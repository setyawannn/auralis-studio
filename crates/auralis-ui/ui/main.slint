                    // Percentage
                    Text {
                        text: Math.round(root.chat-volume * 100) + "%";
                        color: Palette.text-normal;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    // "To Be Routed" Container (Chat: Click to switch to Game)
                    Text {
                        text: "To Be Routed (Chat Apps)";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 72px;
                        background: Palette.surface0;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.border;
                        clip: true;

                        ScrollView {
                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;
                                for app in root.chat-apps: Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: #352B11;
                                    border-width: 1px;
                                    border-color: Palette.accent-chat;
                                    
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        alignment: space-between;

                                        Text {
                                            text: app.name;
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #FFF8E1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "⇄ GAME";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: Palette.accent-chat;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.switch-app-channel(app.name);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Mute Button
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: root.chat-muted ? #FF1744 : Palette.surface2;
                        
                        Text {
                            text: root.chat-muted ? "MUTED" : "MUTE";
