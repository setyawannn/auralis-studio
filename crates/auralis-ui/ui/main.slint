import { VerticalBox, HorizontalBox, Slider, CheckBox, ComboBox, Button, ScrollView } from "std-widgets.slint";

export struct AppSessionItem {
    name: string,
    is_chat: bool,
    is_muted: bool,
}

export global Palette {
    out property <color> surface0: #111317; // Deep Obsidian
    out property <color> surface1: #181B20; // Dark Carbon
    out property <color> surface2: #22262E; // Muted Slate
    out property <color> border: #2E3440;   // Subtle Graphite
    
    out property <color> accent-game: #00E5FF;
    out property <color> accent-chat: #FFB300;
    out property <color> accent-mic: #00E676;
    out property <color> accent-master: #7C4DFF;
    out property <color> text-normal: #E4E4E7;
    out property <color> text-muted: #A1A1AA;
}

// Custom responsif VU Meter (Vertical) dengan threshold warna akurat (Green -> Yellow -> Red)
component VuMeter inherits Rectangle {
    in property <float> level: 0.0; // 0.0 to 1.0
    
    width: 10px;
    background: Palette.surface0;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
    clip: true;

    // Full height gradient (0% - 65% Hijau, 65% - 85% Kuning, 85% - 100% Merah)
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(0deg, #00E676 0%, #00E676 65%, #FFEA00 85%, #FF1744 95%);
    }

    // Mask penutup dari atas (menghalangi bagian level yang belum tercapai)
    Rectangle {
        y: 0px;
        width: 100%;
        height: parent.height * (1.0 - clamp(level, 0.0, 1.0));
        background: Palette.surface0;
    }
}

export component MainWindow inherits Window {
    title: "Auralis Audio Studio";
    width: 980px;
    height: 640px;
    background: Palette.surface0;
    default-font-family: "Segoe UI Variable Text";

    // Telemetry State
    in property <float> vu-master-l: 0.0;
    in property <float> vu-master-r: 0.0;
    in property <float> vu-game-l: 0.0;
    in property <float> vu-game-r: 0.0;
    in property <float> vu-chat-l: 0.0;
    in property <float> vu-chat-r: 0.0;
    in property <float> vu-mic: 0.0;
    
    in-out property <float> master-volume: 0.8;
    in-out property <float> game-volume: 1.0;
    in-out property <float> chat-volume: 1.0;
    in-out property <float> mic-volume: 1.0;
    in-out property <float> chatmix-balance: 0.0; // -1.0 to 1.0

    in-out property <bool> master-muted: false;
    in-out property <bool> game-muted: false;
    in-out property <bool> chat-muted: false;
    in-out property <bool> mic-muted: false;

    property <float> prev-master-volume: 0.8;
    property <float> prev-game-volume: 1.0;
    property <float> prev-chat-volume: 1.0;
    property <float> prev-mic-volume: 1.0;

    // Hardware Output Devices & Microphone Input Devices
    in property <[string]> output-devices: [];
    in-out property <int> selected-output-index: 0;
    callback output-device-selected(string);

    in property <[string]> input-devices: [];
    in-out property <int> selected-input-index: 0;
    callback input-device-selected(string);

    // App Audio Sessions Models
    in property <[AppSessionItem]> all-apps: [];
    in property <[AppSessionItem]> game-apps: [];
    in property <[AppSessionItem]> chat-apps: [];

    callback toggle-app-mute(string);
    callback switch-app-channel(string);

    // Audio Controls Callbacks
    callback master-volume-changed(float);
    callback game-volume-changed(float);
    callback chat-volume-changed(float);
    callback mic-volume-changed(float);
    callback chatmix-changed(float);

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // 1. TOP BAR: Dual Dropdowns (Output & Input)
        HorizontalLayout {
            spacing: 24px;
            alignment: space-between;

            // Output Selector
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Output";
                    color: Palette.text-normal;
                    font-weight: 700;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                ComboBox {
                    width: 380px;
                    model: root.output-devices;
                    current-index <=> root.selected-output-index;
                    selected(name) => {
                        root.output-device-selected(name);
                    }
                }
            }

            // Input (Mic) Selector
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Input";
                    color: Palette.text-normal;
                    font-weight: 700;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                ComboBox {
                    width: 380px;
                    model: root.input-devices;
                    current-index <=> root.selected-input-index;
                    selected(name) => {
                        root.input-device-selected(name);
                    }
                }
            }
        }

        // 2. MAIN WORKSPACE: 4 Uniform Vertical Mixer Cards
        HorizontalLayout {
            spacing: 14px;

            // --- CARD 1: MASTER VOLUME ---
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.surface1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // Header
                    Text {
                        text: "Master Volume";
                        color: Palette.accent-master;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }

                    // VU Meter & Fader
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 3px;
                            VuMeter { level: root.vu-master-l; height: 160px; }
                            VuMeter { level: root.vu-master-r; height: 160px; }
                        }

                        // Tactile Fader
                        Rectangle {
                            width: 28px;
                            height: 160px;
                            background: Palette.surface0;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Palette.border;

                            Rectangle {
                                x: 12px;
                                y: 10px;
                                width: 4px;
                                height: parent.height - 20px;
                                background: Palette.surface2;
                                border-radius: 2px;
                            }

                            Rectangle {
                                x: 12px;
                                y: (parent.height - 20px) * (1.0 - root.master-volume) + 10px;
                                width: 4px;
                                height: (parent.height - 20px) * root.master-volume;
                                background: Palette.accent-master;
                                border-radius: 2px;
                            }

                            Rectangle {
                                x: 4px;
                                y: (parent.height - 20px) * (1.0 - root.master-volume);
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: #FFFFFF;
                                border-width: 2px;
                                border-color: Palette.accent-master;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        let travel = self.height - 20px;
                                        let pos = clamp(self.mouse-y - 10px, 0px, travel);
                                        root.master-volume = clamp(1.0 - (pos / travel), 0.0, 1.0);
                                        root.master-volume-changed(root.master-volume);
                                    }
                                }
                                moved => {
                                    let travel = self.height - 20px;
                                    let pos = clamp(self.mouse-y - 10px, 0px, travel);
                                    root.master-volume = clamp(1.0 - (pos / travel), 0.0, 1.0);
                                    root.master-volume-changed(root.master-volume);
                                }
                            }
                        }
                    }

                    // Percentage
                    Text {
                        text: Math.round(root.master-volume * 100) + "%";
                        color: Palette.text-normal;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    // "To Be Routed" Container (Master: Click to Mute/Unmute individual app)
                    Text {
                        text: "To Be Routed";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 72px;
                        background: Palette.surface0;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.border;
                        clip: true;

                        ScrollView {
                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;
                                for app in root.all-apps: Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: app.is_muted ? #3E1822 : #251F3D;
                                    border-width: 1px;
                                    border-color: app.is_muted ? #FF1744 : Palette.accent-master;
                                    
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        alignment: space-between;

                                        Text {
                                            text: app.name;
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: app.is_muted ? #FF8A80 : #D1C4E9;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: app.is_muted ? "MUTED" : "ON";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: app.is_muted ? #FF1744 : Palette.accent-master;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.toggle-app-mute(app.name);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Mute Button
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: root.master-muted ? #FF1744 : Palette.surface2;
                        
                        Text {
                            text: root.master-muted ? "MUTED" : "MUTE";
                            color: root.master-muted ? #FFFFFF : Palette.text-normal;
                            font-weight: 700;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.master-muted = !root.master-muted;
                                if (root.master-muted) {
                                    root.prev-master-volume = root.master-volume;
                                    root.master-volume = 0.0;
                                } else {
                                    root.master-volume = root.prev-master-volume > 0.05 ? root.prev-master-volume : 0.8;
                                }
                                root.master-volume-changed(root.master-volume);
                            }
                        }
                    }
                }
            }

            // --- CARD 2: GAME VOLUME ---
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.surface1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // Header
                    Text {
                        text: "Game Volume";
                        color: Palette.accent-game;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }

                    // VU Meter & Fader
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 3px;
