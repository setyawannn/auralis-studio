                                width: 4px;
                                height: (parent.height - 20px) * root.game-volume;
                                background: Palette.accent-game;
                                border-radius: 2px;
                            }

                            Rectangle {
                                x: 4px;
                                y: (parent.height - 20px) * (1.0 - root.game-volume);
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: #FFFFFF;
                                border-width: 2px;
                                border-color: Palette.accent-game;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        let travel = self.height - 20px;
                                        let pos = clamp(self.mouse-y - 10px, 0px, travel);
                                        root.game-volume = clamp(1.0 - (pos / travel), 0.0, 1.0);
                                        root.game-volume-changed(root.game-volume);
                                    }
                                }
                                moved => {
                                    let travel = self.height - 20px;
                                    let pos = clamp(self.mouse-y - 10px, 0px, travel);
                                    root.game-volume = clamp(1.0 - (pos / travel), 0.0, 1.0);
                                    root.game-volume-changed(root.game-volume);
                                }
                            }
                        }
                    }

                    // Percentage
                    Text {
                        text: Math.round(root.game-volume * 100) + "%";
