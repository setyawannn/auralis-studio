                        border-color: Palette.border;
                        clip: true;

                        ScrollView {
                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;
                                for app in root.game-apps: Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: #112A35;
                                    border-width: 1px;
                                    border-color: Palette.accent-game;
                                    
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        alignment: space-between;

                                        Text {
                                            text: app.name;
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #E0F7FA;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "⇄ CHAT";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: Palette.accent-game;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.switch-app-channel(app.name);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Mute Button
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: root.game-muted ? #FF1744 : Palette.surface2;
                        
                        Text {
                            text: root.game-muted ? "MUTED" : "MUTE";
                            color: root.game-muted ? #FFFFFF : Palette.text-normal;
                            font-weight: 700;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.game-muted = !root.game-muted;
                                if (root.game-muted) {
                                    root.prev-game-volume = root.game-volume;
                                    root.game-volume = 0.0;
                                } else {
                                    root.game-volume = root.prev-game-volume > 0.05 ? root.prev-game-volume : 1.0;
                                }
                                root.game-volume-changed(root.game-volume);
                            }
                        }
                    }
                }
            }

            // --- CARD 3: CHAT VOLUME ---
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.surface1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // Header
                    Text {
                        text: "Chat Volume";
                        color: Palette.accent-chat;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }

                    // VU Meter & Fader
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 3px;
                            VuMeter { level: root.vu-chat-l; height: 160px; }
                            VuMeter { level: root.vu-chat-r; height: 160px; }
                        }

                        // Tactile Fader
                        Rectangle {
                            width: 28px;
                            height: 160px;
                            background: Palette.surface0;
                            border-radius: 6px;
