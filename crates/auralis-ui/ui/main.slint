                        horizontal-alignment: center;
                    }

                    // Status Badge Container
                    Text {
                        text: "To Be Routed (Mic FX)";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 72px;
                        background: Palette.surface0;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.border;
                        clip: true;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            alignment: center;

                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: #0E2E1E;
                                border-width: 1px;
                                border-color: Palette.accent-mic;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: space-between;
                                    Text {
                                        text: "🎙 Clean Voice Gate";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #E8F5E9;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "ACTIVE";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Palette.accent-mic;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: Palette.surface2;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: space-between;
                                    Text {
                                        text: "⚡ Ultra-Low Latency";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: Palette.text-muted;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "WASAPI";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Palette.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Mute Button
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: root.mic-muted ? #FF1744 : Palette.surface2;
                        
                        Text {
                            text: root.mic-muted ? "MUTED" : "MUTE";
                            color: root.mic-muted ? #FFFFFF : Palette.text-normal;
                            font-weight: 700;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.mic-muted = !root.mic-muted;
                                if (root.mic-muted) {
                                    root.prev-mic-volume = root.mic-volume;
                                    root.mic-volume = 0.0;
                                } else {
                                    root.mic-volume = root.prev-mic-volume > 0.05 ? root.prev-mic-volume : 1.0;
                                }
                                root.mic-volume-changed(root.mic-volume);
                            }
                        }
                    }
                }
            }
        }

        // 3. BOTTOM BAR: Centered Chat Mix Crossfader
        Rectangle {
            height: 72px;
            background: Palette.surface1;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: "Chat Mix";
                    color: Palette.text-normal;
                    font-weight: 700;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    Text {
                        text: "Game";
                        color: Palette.accent-game;
                        font-weight: 700;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Slider {
                        width: 500px;
                        minimum: -100;
                        maximum: 100;
                        value: 0;
                        changed(val) => {
                            root.chatmix-balance = val / 100.0;
                            root.chatmix-changed(root.chatmix-balance);
                        }
                    }

                    Text {
                        text: "Chat";
                        color: Palette.accent-chat;
                        font-weight: 700;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}